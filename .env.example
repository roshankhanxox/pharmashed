# Assistant — get a free key at https://console.groq.com
GROQ_API_KEY=

# Model to use — check available models with: GET https://api.groq.com/openai/v1/models
# Default uses the largest available GPT-OSS model on this account
ASSISTANT_MODEL=openai/gpt-oss-120b

# FHIR server (optional, only needed for live FHIR validation)
HAPI_BASE=http://localhost:8080/fhir

# Data directory (default: data/build; use contracts/fixtures for dev)
# PHARMASHED_DATA=contracts/fixtures
